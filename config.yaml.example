# 监听 host / port
host: "0.0.0.0"
port: 8080

# 后端 llama.cpp 地址
backend: "http://127.0.0.1:8081"

# 启动命令
startupCommand: "sudo /usr/bin/supervisorctl start llama"

# 执行 command 后端口就绪后再等多少秒才转发，默认 0
waitBackendReady: 0

# ===== restart 重启配置：enable 为 true 时启用 =====
restart:
  enable: true
  # 空闲多久(秒)触发，默认 600
  interval: 300
  # 执行的命令
  command: "sudo /usr/bin/supervisorctl stop llama && sleep 3 && sudo /usr/bin/supervisorctl start llama"

# ===== probe 后端探测配置：enable 为 true 时启用 =====
probe:
  enable: true
  # 空闲多久(秒)触发，默认 600
  interval: 600
  # 探测判定异常后执行的命令
  command: "sudo /usr/bin/supervisorctl stop llama && sleep 3 && sudo /usr/bin/supervisorctl start llama"
  # 探测 api key（仅探测时携带 Bearer <key>，正常代理不使用）
  apiKey: ""
  # 探测模型名，默认 "default"
  model: "default"
  # 探测 prompt，默认 "hi"
  prompt: "hi"
  # 探测最大生成 token 数，默认 64
  maxTokens: 64
  # 连续重复 token 判定异常阈值，默认 20
  repeatLimit: 20
  # 探测超时(秒)，默认 5
  timeout: 5
