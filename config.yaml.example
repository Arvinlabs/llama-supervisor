# 监听 host / port
host: "0.0.0.0"
port: 8080

# 后端 llama.cpp 地址
backend: "http://127.0.0.1:8081"

# 启动命令
startupCommand: "sudo /usr/bin/supervisorctl start llama"

# ===== restart 重启配置：enable 为 true 时启用 =====
restart:
  enable: true
  # 空闲多久(秒)触发，默认 600
  interval: 300
  # 执行的命令
  command: "sudo /usr/bin/supervisorctl stop llama && sleep 3 && sudo /usr/bin/supervisorctl start llama"

# ===== probe 后端探测配置：enable 为 true 时启用 =====
probe:
  enable: true
  # 空闲多久(秒)触发，默认 600
  interval: 600
  # 探测判定异常后执行的命令
  command: "sudo /usr/bin/supervisorctl stop llama && sleep 3 && sudo /usr/bin/supervisorctl start llama"
  # 探测 api key（仅探测时携带 Bearer <key>，正常代理不使用）
  apiKey: ""
  # 探测模型名，默认 "default"
  model: "default"
  # 探测 prompt，默认 "hi"
  prompt: "hi"
  # 探测最大生成 token 数，默认 64
  maxTokens: 64
  # 连续重复字符判定异常阈值，默认 10
  repeatLimit: 10
  # 正常内容累计达到该字符数即提前判定健康，不等生成结束，默认 20（设为负值禁用）
  successLimit: 20
  # 探测超时(秒)，默认 5
  timeout: 5

# ===== watchdog 速度看门狗配置：enable 为 true 时启用 =====
watchdog:
  enable: true
  # 采样 /slots 间隔(秒)，默认 2
  interval: 2
  # 后端 api key（采样 /slots 时携带 Bearer <key>，正常代理不使用），默认空（不携带）
  apiKey: ""
  # 生成速度上限(t/s)，超过则判异常（死循环），默认 200
  maxRate: 200
  # 连续超速几次判异常，默认 2
  times: 2
  # 是否打印测速正常日志（有请求且速度正常时 info），默认 false
  verbose: false
  # 判定异常后执行的命令
  command: "sudo /usr/bin/supervisorctl stop llama && sleep 3 && sudo /usr/bin/supervisorctl start llama"
