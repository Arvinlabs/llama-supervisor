# listen host / port
host: "0.0.0.0"
port: 8080

# backend llama.cpp address
backend: "http://127.0.0.1:8081"

# global backend API key (sent as Bearer <key> on probe, /slots sampling, cloud context-window detection and the /tokenize prompt counting the cloud routing depends on; not used by normal proxying), default empty (not sent). Required on key-protected backends, otherwise the cloud routing cannot see the context window or count a prompt and everything stays local
apiKey: ""

# startup command
startupCommand: "sudo /usr/bin/supervisorctl start llama"

# ===== restart config: enabled when enable is true =====
restart:
  enable: true
  # trigger after being idle this many seconds, default 600
  interval: 300
  # command to run
  command: "sudo /usr/bin/supervisorctl stop llama && sleep 3 && sudo /usr/bin/supervisorctl start llama"

# ===== probe config: enabled when enable is true =====
probe:
  enable: true
  # trigger after being idle this many seconds, default 600
  interval: 600
  # command to run after the probe declares unhealthy
  command: "sudo /usr/bin/supervisorctl stop llama && sleep 3 && sudo /usr/bin/supervisorctl start llama"
  # probe model name, default "default"
  model: "default"
  # probe prompt, default "hi"
  prompt: "hi"
  # max generated tokens for the probe, default 64
  maxTokens: 64
  # repeated-tail threshold for declaring unhealthy, default 10
  repeatLimit: 10
  # whitelist: only these characters' consecutive repetition counts as degenerate; empty (default) means any character
  repeatChars: ""
  # once normal content reaches this many characters the backend is declared healthy early without waiting for generation to finish, default 20 (negative disables)
  successLimit: 20
  # probe timeout in seconds, default 5
  timeout: 5

# ===== watchdog config: enabled when enable is true =====
watchdog:
  enable: true
  # /slots sampling interval in seconds, default 2. Sampling is request-driven:
  # the first fetch happens a fixed 1 second after a chat completion request arrives,
  # then every interval as long as any request is in flight (idle means no sampling)
  interval: 2
  # max generation speed (t/s); above it is declared unhealthy (output loop), default 300
  maxRate: 300
  # consecutive over-speed samples required to declare unhealthy, default 2
  times: 2
  # seconds the watchdog fully pauses (no /slots fetching at all) after a trigger or a /slots fetch failure, default 30
  pause: 30
  # whether to log the measured speed on normal windows, default false
  verbose: false
  # min MTP draft acceptance ratio (timings.draft_n_accepted / timings.draft_n) sampled from every
  # observed chat completion; a completion below it for draftTimes in a row is declared unhealthy
  # and runs command. 0 (default) disables this check
  minDraftRate: 0
  # consecutive low draft-acceptance completions required to declare unhealthy, default 10
  draftTimes: 10
  # content-loop judgment at an over-speed trigger: consecutive identical tail runes in a
  # streaming completion's generated content that mark it a dead loop; when the over-speed
  # streak is reached, a streaming in-flight completion triggers only when its content is
  # degenerate (held and re-judged until then), while a non-streaming one, having no content
  # to judge, triggers directly. Default 10
  repeatLimit: 10
  # whitelist: only these characters' consecutive repetition counts as a dead loop; empty
  # (default) means any character
  repeatChars: ""
  # independent dead-loop trigger: a streaming run of this many identical tail runes triggers
  # directly, without any over-speed (a model can also loop at a speed that never crosses
  # maxRate). Default 100, a value <= 0 disables
  hardRepeat: 100
  # command to run after declaring unhealthy
  command: "sudo /usr/bin/supervisorctl stop llama && sleep 3 && sudo /usr/bin/supervisorctl start llama"

# ===== errguard config: enabled when enable is true =====
# backend error guard: the supervisor taps every proxied /v1/chat/completions response
# (streaming and non-streaming) and looks for an OpenAI-style error object in the backend
# payload - a stream event `data: {"error":{"type":"server_error","message":"..."}}` or a
# plain non-stream JSON body `{"error":{"type":"server_error","message":"..."}}`. When the
# error message matches any pattern the command runs, so a backend fault that surfaces as an
# error payload (instead of a hang or an output loop the probe/restart/watchdog catch) is
# also self-healed
errguard:
  enable: false
  # list of regular expressions (Go regexp) matched against the backend error message;
  # an empty list matches nothing (the guard never triggers)
  patterns:
    - "out of memory"
    - "server_error"
  # command to run when an error message matches
  command: "sudo /usr/bin/supervisorctl stop llama && sleep 3 && sudo /usr/bin/supervisorctl start llama"
  # seconds during which the command is not re-run after a trigger, so a burst of matching
  # errors (many concurrent requests hitting the same backend fault) runs the command once;
  # default 30, a value <= 0 disables the cooldown
  cooldown: 30

# ===== stats config: enabled when enable is true =====
# per-day token usage accounting for /v1/chat/completions: one JSON file per day (YYYY-MM-DD.json)
# in savePath with the day's cumulative counters (requests/input/input_cache/output/total).
# Streaming requests get stream_options.include_usage force-injected so the usage is always
# reported (the client receives one extra standard usage chunk at the end of the stream)
stats:
  enable: false
  # directory the daily stats JSON files are saved to; empty disables the policy
  # each day file holds the day's counters plus a "cloud" object with the subset of
  # them that was routed to the cloud backend, so the local/cloud split is visible
  savePath: ""
  # how many days of stats files are kept, older ones are deleted; default 7
  retainDays: 7

# ===== debug config: enabled when enable is true =====
# a manual trigger: requesting the endpoint runs the command synchronously and returns the result
# (GET/POST /debug/command). No authentication - keep it reachable only from trusted networks
debug:
  enable: false
  # endpoint path, default "/debug/command"
  path: "/debug/command"
  # command to run on request
  command: "sudo /usr/bin/supervisorctl stop llama && sleep 3 && sudo /usr/bin/supervisorctl start llama"
  # when debug is enabled: directory to dump every inbound proxied request to as a plain text
  # file named by the request time (YYYYMMDD_HHMMSS.mmm.txt, full request line + headers
  # + body; JSON bodies are stored pretty-printed, non-JSON bodies base64-encoded so
  # the dump stays plain text); empty disables saving
  savePath: ""
  # when debug is enabled: directory to dump every outbound proxied request to (after the request
  # policy has rewritten it, when request.enable is true) using the same plain text format as
  # savePath; empty disables saving
  outSavePath: ""
  # when debug is enabled: directory to dump every backend response to as a JSON file named by
  # the response time (YYYYMMDD_HHMMSS.mmm.json): the status line, the headers and the body -
  # a non-streaming body is stored as the parsed JSON (base64-encoded when not valid JSON),
  # a streaming (SSE) chat completion is assembled into the same non-streaming structure
  # (the per-chunk deltas merged into one message, usage/timings taken from the final chunk);
  # a stream that is not a chat completion falls back to a JSON array of the data events
  # (JSON payloads parsed, others kept as raw strings, e.g. [DONE]); empty disables saving
  respSavePath: ""

# ===== request policy config: enabled when enable is true =====
request:
  enable: true
  # virtual keys: list of virtual API keys; when non-empty the supervisor requires clients to
  # present one of them in the OpenAI format (Authorization: Bearer <key>) and re-signs the
  # outbound request with the global apiKey (the virtual keys never reach the backend).
  # Missing or unknown keys are rejected with an OpenAI-format 401 error. Empty list disables it
  virtualKeys:
    - "sk-virtual-key-1"
    - "sk-virtual-key-2"
  # prefix cache: normalize /v1/chat/completions request bodies (sort the tools list by tool
  # name, sort all JSON object keys recursively) so semantically identical requests share one
  # canonical byte form and the backend prefix cache hits
  prefixCache: true

# ===== cloud fallback config: enabled when enable is true =====
# when the estimated size of a /v1/chat/completions request exceeds the local model's
# context window (n_ctx), that request is routed to the configured OpenAI-compatible
# cloud endpoint instead of the local backend; smaller requests and everything else
# (non-chat paths, undecidable requests) always stay local
cloud:
  enable: false
  # cloud endpoint base URL, e.g. https://api.deepseek.com (no trailing slash)
  baseUrl: "https://api.deepseek.com"
  # cloud API key, sent to the cloud as Bearer <key>; client keys (virtual or real)
  # never reach the cloud
  apiKey: "sk-..."
  # model name rewritten into the request when it is routed to the cloud; empty
  # passes the client's model name through unchanged
  model: "deepseek-chat"
  # local context window in tokens; 0 (default) means auto-detect from the backend
  # (GET /props n_ctx, fallback: the n_ctx= suffix of the model ids from GET /v1/models),
  # re-checked every 5 minutes so a backend restart with new parameters is picked up
  localMaxTokens: 0
  # the request is routed to the cloud when its estimated token size exceeds
  # n_ctx * threshold; default 0.9 (a 10% headroom)
  threshold: 0.9
  # output tokens reserved for the decision when the client did not set max_tokens;
  # the decision uses max(max_tokens, this). Default 1024
  outputReserve: 1024
  # factor the prompt size estimate is multiplied by before the decision (the
  # estimate is a lower bound: image parts and the chat template's rendering are
  # only approximated, and some templates render the tools definitions
  # repeatedly). Default 1 (no allowance)
  estimateMargin: 1
  # max in-flight cloud requests; further requests wait for a slot (or for their
  # client to disconnect). 0 (default) means unlimited
  maxConcurrency: 0

# ===== anthropic protocol support config: enabled when enable is true =====
# when enabled the supervisor accepts the Anthropic Messages API at POST /v1/messages:
# the request is translated to the OpenAI chat completion protocol at the outer edge and
# proxied to the supervisor itself, so the full OpenAI pipeline (auth, request policy,
# usage injection, stats, watchdog) runs unmodified, and the OpenAI response (JSON or SSE)
# is translated back to the Anthropic protocol for the client. The client's API key
# (x-api-key header, or Authorization verbatim) is passed through to the self request;
# the request policy is the single authentication point for both protocols
anthropic:
  enable: false
  # optional client model name -> backend model name remapping; unmapped names pass
  # through to the backend unchanged
  modelMap:
    # "claude-sonnet-4-5": "default"
